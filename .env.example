# ============================================================
# CRDB 生产环境配置（复制为 .env 后修改）
#   cp .env.example .env
# ============================================================

# ---------- 站点 ----------
# 部署域名（setup_nginx_vhost.sh 会用它申请证书并挂 vhost 到 Ticketsys 的 nginx）
DOMAIN=crdb.neftoo.xyz
# 证书到期提醒邮箱
CERTBOT_EMAIL=admin@neftoo.xyz

# ---------- 数据库 ----------
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=请改成强密码
POSTGRES_PORT=5432

# ---------- 端口 ----------
# 80/443/5432/8000/8080 等已被 Ticketsys 和宝塔占用，CRDB 全部避开：
#   - postgres / api 不映射宿主机端口
#   - web 默认用 18080；若仍冲突，改成一个没人用的端口即可
# 公网域名访问（443）走 Ticketsys 的 nginx 反代，见 deploy/setup_nginx_vhost.sh
API_PORT=8000
WEB_PORT=18080

# ---------- 后端 ----------
# uvicorn worker 数量；2~4GB 小机建议 1（省内存），4GB 充足可设 2
API_WORKERS=1
# 容器启动时自动建库/建表/建索引（幂等，可保持 true）
INIT_DB=true
# 数据由 pg_dump 从本地迁移，不从 xlsx 导入（保持 false；要恢复再改 true）
IMPORT_EXCEL=false
# 关闭导出/下载接口（配合前端 VITE_DISABLE_DOWNLOAD，双保险）
DISABLE_EXPORT=true

# ---------- 前端（构建期生效，改完必须重新 build）----------
# true = 保留「导出/下载」按钮但点击无任何反应
VITE_DISABLE_DOWNLOAD=true

# ---------- 镜像 tag ----------
VERSION=1.0.0

# ---------- 性能调优（面向 2~4GB 小内存阿里云）----------
# 以下默认值已针对小机优化；若机器是 4GB 且同机无 Ticketsys/宝塔，可适当调大。
# PostgreSQL 内存参数（覆盖索引仅扫描 + 合适 work_mem，让千万级聚合不落盘）
PG_SHARED_BUFFERS=384MB
PG_EFFECTIVE_CACHE_SIZE=1152MB
PG_WORK_MEM=32MB
PG_MAINTENANCE_WORK_MEM=128MB
PG_MAX_CONNECTIONS=60
# PostgreSQL 容器内存上限。
# 说明：按运维结论，1G 硬上限会导致大查询超时/OOM，故 docker-compose.prod.yml 已不再
# 对 postgres 设硬上限；由后端 MEMORY_GUARD（MEMORY_GUARD_ENABLED=1）在系统可用内存
# 偏低时拒绝重查询（503）兜底，避免主机 OOM。如需恢复硬上限，在 prod 文件 postgres 下加回
#   mem_limit: ${PG_MEM_LIMIT}
# 并设本变量即可。api/web 仍各自保留 API_MEM_LIMIT / WEB_MEM_LIMIT。
PG_MEM_LIMIT=1024m
API_MEM_LIMIT=512m
WEB_MEM_LIMIT=128m
# 看板结果缓存 TTL（秒）；数据重导/清空后会自动失效，可放心设大
DASHBOARD_CACHE_TTL=300

# ---------- 内存安全护栏（始终开启的熔断器，后端进程环境变量）----------
# 系统可用内存低于阈值时，直接 503 拒绝重负载请求，避免 OOM 杀进程。
# 阈值 = max(绝对下限, 总内存 * 相对下限)，随机器大小自适应：
#   2G 小机约 384MB 触发，32G 大服务器约 2.6GB 触发，大小机都生效。
# MEMORY_GUARD_ENABLED=0 可整体关闭（不推荐）。
MEMORY_GUARD_ENABLED=1
MEMORY_GUARD_MIN_AVAILABLE_MB=384
MEMORY_GUARD_MIN_FREE_PCT=0.08

# ---------- 登录鉴权（后端进程环境变量）----------
# JWT 签名密钥：**公网部署务必改成随机长字符串**（openssl rand -base64 48）。
# 不设置则每次启动随机生成——所有人会被强制重新登录，且令牌可被伪造风险更高。
AUTH_SECRET_KEY=请改成随机长字符串
# 登录有效期（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=480
# bcrypt 计算强度（12 为安全与性能的平衡点，小机可设 10）
BCRYPT_ROUNDS=12
# 默认管理员账号：仅首次启动自动创建；之后改这里不再生效，请在「后台管理」中维护
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=请改成强密码
ADMIN_INITIAL_NAME=系统管理员
# 允许访问的前端来源（逗号分隔）。公网部署务必改为实际域名，切勿长期保持 *
CORS_ORIGINS=*

# ---------- 导出/导入闸门（重负载保护：防止多人同时导出把服务器挤崩）----------
# 同时最多几个导出/导入任务在跑；超出的请求先等 EXPORT_QUEUE_WAIT_SEC 秒
# （小机建议 1~2；API_WORKERS>1 时实际上限 = 本值 × workers）
EXPORT_MAX_CONCURRENT=2
# 同一账号两次导出之间的最小间隔（秒），防连点/脚本狂刷
EXPORT_MIN_INTERVAL_SEC=5
# 并发满时最多排队等待（秒）；到点仍排不上直接返回 429（快速失败优于排队占内存）
EXPORT_QUEUE_WAIT_SEC=3
# 单次导出（含导入）行数上限；触顶即停，并在 CSV 末尾追加一条提示行
EXPORT_MAX_ROWS=3000000
# 导出专用连接上的语句超时（毫秒）：SQL 跑飞由 PostgreSQL 主动杀掉，不占死连接
EXPORT_STATEMENT_TIMEOUT_MS=600000
# CSV 每块输出字节数 / 服务端游标每次取行数（默认即可，一般不用改）
EXPORT_CHUNK_BYTES=262144
EXPORT_FETCH_SIZE=5000

# ---------- 查询闸门（重查询保护：防止多人同时查询把服务器挤爆）----------
# 仅对「重查询」GET 接口生效：/rows（实销查看主表）、/stats/*、/dashboard/*、/inventory/*；
# 轻量元数据接口（/api/dbs、/api/filter_options 等）不受限，保证重查询排队时页面仍能加载。
# 同时最多几个重查询在跑；超出的请求先等 QUERY_QUEUE_WAIT_SEC 秒
# （小机建议 3~4；API_WORKERS>1 时实际上限 = 本值 × workers）
QUERY_MAX_CONCURRENT=4
# 同一账号对「同一接口」两次查询的最小间隔（秒），防连点/脚本狂刷
QUERY_MIN_INTERVAL_SEC=0.5
# 并发满时最多排队等待（秒）；到点仍排不上直接返回 429（快速失败优于排队占内存）
QUERY_QUEUE_WAIT_SEC=2
# 只读查询连接上的语句超时（毫秒）：慢查询 SQL 跑飞由 PostgreSQL 主动杀掉，不占死连接
QUERY_STATEMENT_TIMEOUT_MS=30000
# 实销查看 /rows 列表查询结果缓存 TTL（秒）；相同筛选+分页条件直接命中，导入/清空自动失效
ROWS_CACHE_TTL=15

# ---------- AI 问数（规则路径 0 token；LLM 兜底由 ai 服务承担）----------
# 默认路径是纯规则（L0 提取 + L1 别名），不调用任何模型：高频问法直接出结果。
# 只有「连能力都没识别出来」、且该用户在页面里配了自己的 API Key 时，
# 才会把请求转给 ai 服务（L2 兜底，单步补槽位）。
# 设 false = 纯规则模式：AI 助手照常可用，只是长尾问法要人工补槽。
AI_BRIDGE_ENABLED=true
# ai 服务地址（compose 服务名）；本机直接跑 ai-bridge 时改成 http://127.0.0.1:3000
AI_BRIDGE_URL=http://ai:3000
# 单次 L2 补槽超时（秒）：超时即静默退回规则路径，不会让提问卡住
AI_BRIDGE_TIMEOUT=8
# 规则置信度低于此值才花钱问模型（0~1）；调低 = 更少调用、更依赖规则
AI_LLM_FILL_THRESHOLD=0.6
# ai 容器内存上限（见 docker-compose.prod.yml）：只补槽位不查数，256m 足够
AI_MEM_LIMIT=256m
