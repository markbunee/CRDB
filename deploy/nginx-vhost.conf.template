# ============================================================
# CRDB 反代 vhost（模板）
# 挂在 **Ticketsys 的 nginx** 上，复用它的 80/443，避免端口冲突。
# deploy/setup_nginx_vhost.sh 会把 ${DOMAIN} 替换成真实域名后
# 拷进 ticketsys-web:/etc/nginx/conf.d/crdb.conf
# ============================================================

# ---------- HTTP 80：ACME 验证 + 跳 HTTPS ----------
server {
    listen 80;
    server_name ${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---------- HTTPS 443 ----------
server {
    listen 443 ssl;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    client_max_body_size 200m;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml text/csv;
    gzip_min_length 1024;

    # ---------- 导出 CSV（流式，必须放在 location / 之前）----------
    # 不缓冲：否则几百 MB 的导出会先整份落到 nginx 的临时文件，小盘机器危险
    location ~ ^/api/.+/export {
        proxy_pass http://crdb-web:80;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_connect_timeout 30s;
        # 与后端「语句超时 10 分钟」对齐并留余量
        proxy_send_timeout 1800s;
        proxy_read_timeout 1800s;
    }

    # crdb-web 已通过 docker network connect 接入同一个网络
    location / {
        proxy_pass http://crdb-web:80;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 30s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
    }
}
